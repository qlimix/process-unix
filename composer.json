{
    "name": "qlimix/process-unix",
    "type": "library",
    "description": "Running sync long running processes",
    "license": "MIT",
    "keywords": [
        "process",
        "sync",
        "long",
        "running"
    ],
    "authors": [
        {
            "name": "frank",
            "email": "frank@qlimix.net"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "qlimix/process": "dev-upgrade-3.0"
    },
    "require-dev": {
        "qlimix/code-standard": "dev-upgrade-4.0"
    },
    "autoload": {
        "psr-4": {
            "Qlimix\\Process\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qlimix\\Tests\\Process\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        }
    }
}
